rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Photographers — anyone logged in can read; only the owner can write
    match /photographers/{photographerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == photographerId;
    }

    // Bookings — clients can create/read their own; photographers can read bookings for them
    match /bookings/{bookingId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        (resource.data.clientId == request.auth.uid ||
         resource.data.photographerId == request.auth.uid);
      allow update, delete: if false; // managed server-side only
    }
  }
}
