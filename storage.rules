rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── portfolios/{uid}/{file} ──────────────────────────────────────────────
    // A photographer can upload and delete files under their own uid prefix.
    // Anyone signed in can read (download) portfolio images for browsing.
    match /portfolios/{uid}/{allPaths=**} {
      // Authenticated users can read (browse portfolios)
      allow read: if request.auth != null;

      // Only the owner can write (create / update) — file size ≤ 10 MB,
      // content type must be an image.
      allow write: if request.auth != null
          && request.auth.uid == uid
          && request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');

      // Owner can delete their own images
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
